{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/Home.dc.html" }
  ],
  "redirects": [
    { "source": "/home", "destination": "/Home.dc.html" },
    { "source": "/tour", "destination": "/Tour.dc.html" },
    { "source": "/music", "destination": "/Music.dc.html" },
    { "source": "/merch", "destination": "/Merch.dc.html" },
    { "source": "/shop", "destination": "/Merch.dc.html" },
    { "source": "/about", "destination": "/About.dc.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
